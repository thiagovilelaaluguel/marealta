{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/ir/booking-1303/",
      "destination": "https://www.booking.com/Share-ze25Ftx",
      "permanent": false
    },
    {
      "source": "/ir/booking-1304/",
      "destination": "https://www.booking.com/Share-KpXcRG",
      "permanent": false
    },
    {
      "source": "/ir/booking-607/",
      "destination": "https://www.booking.com/Share-FtEYBA",
      "permanent": false
    },
    {
      "source": "/ir/booking-807/",
      "destination": "https://www.booking.com/Share-lhzoql",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
